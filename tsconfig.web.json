{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "jsx": "preserve", "noEmit": true
  },
  "include": ["src/shared/**/*", "src/renderer/src/**/*", "src/preload/index.d.ts"]
}
