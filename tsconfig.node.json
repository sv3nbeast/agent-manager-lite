{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "types": ["node", "electron-vite/node"],
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true
  },
  "include": ["electron.vite.config.ts", "src/shared/**/*", "src/main/**/*", "src/preload/**/*"]
}
